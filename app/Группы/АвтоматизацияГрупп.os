Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

Функция РаспределитьУчастников(Ид) Экспорт
    Соединение = Новый Соединение();
    Соединение.ТипСУБД = Соединение.ТипыСУБД.PostgreSQL;
    Соединение.ИмяБазы = ПолучитьПеременнуюСреды("DB_NAME");
    Соединение.ИмяПользователя = ПолучитьПеременнуюСреды("DB_USER");
    Соединение.Пароль = ПолучитьПеременнуюСреды("DB_PASS");
    Соединение.Сервер = ПолучитьПеременнуюСреды("DB_HOST");
    Соединение.Порт = Число(ПолучитьПеременнуюСреды("DB_PORT"));
    Соединение.Открыть();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "SELECT u.id
    |FROM exchange_members m
    |JOIN exchanges e ON e.id = m.exchange_id
    |JOIN users u     ON u.id = m.user_id
    |WHERE m.exchange_id = @exchange_id
    |ORDER BY m.joined_at;";
    Запрос.УстановитьПараметр("exchange_id", Число(Ид));
    ПЗ = Запрос.Выполнить().Выгрузить();

    МассивПользователей = Новый Массив();
    Для Каждого П Из ПЗ Цикл
        МассивПользователей.Добавить(Строка(П.id));
    КонецЦикла;

    Генератор = Новый ГенераторСлучайныхЧисел;
    Последний = МассивПользователей.ВГраница();
    Для Сч = 0 По Последний - 1 Цикл
        Инд = Последний - Сч;                        // идём с конца
        Случайный = Генератор.СлучайноеЧисло(0, Инд);

        Временная = МассивПользователей[Инд];
        МассивПользователей[Инд] = МассивПользователей[Случайный];
        МассивПользователей[Случайный] = Временная;
    КонецЦикла;

    Распределение = Новый Соответствие();
    Для Сч = 0 По Последний Цикл
        Если Сч <> Последний Тогда
            Распределение.Вставить(МассивПользователей[Сч], МассивПользователей[Сч + 1]);
        Иначе
            Распределение.Вставить(МассивПользователей[Сч], МассивПользователей[0]);
        КонецЕсли;
    КонецЦикла;

    Запись = Новый ЗаписьJSON();
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Распределение);
    Распределение = Запись.Закрыть();

    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "UPDATE exchanges SET gifters=@gifters, is_selected_gifters=true WHERE id=@id";
    Запрос.УстановитьПараметр("id", Число(Ид));
    Запрос.УстановитьПараметр("gifters", Распределение);
    Запрос.ВыполнитьКоманду();
    Возврат Истина;
КонецФункции

Процедура АвтоматическоеЗавершение() Экспорт
    Соединение = Новый Соединение();
    Соединение.ТипСУБД = Соединение.ТипыСУБД.PostgreSQL;
    Соединение.ИмяБазы = ПолучитьПеременнуюСреды("DB_NAME");
    Соединение.ИмяПользователя = ПолучитьПеременнуюСреды("DB_USER");
    Соединение.Пароль = ПолучитьПеременнуюСреды("DB_PASS");
    Соединение.Сервер = ПолучитьПеременнуюСреды("DB_HOST");
    Соединение.Порт = Число(ПолучитьПеременнуюСреды("DB_PORT"));
    Соединение.Открыть();
    Флаг = Истина;
    Пока Флаг = Истина Цикл
        Запрос = Новый Запрос();
        Запрос.УстановитьСоединение(Соединение);
        Запрос.Текст = "UPDATE exchanges SET is_ended=true WHERE is_ended=false AND swap_date <= @date";
        Запрос.УстановитьПараметр("date", НачалоДня(ТекущаяДата()));
        Запрос.ВыполнитьКоманду();
        Приостановить(43200);
    КонецЦикла;
КонецПроцедуры

Процедура АвтоматическоеРаспределение() Экспорт
    Соединение = Новый Соединение();
    Соединение.ТипСУБД = Соединение.ТипыСУБД.PostgreSQL;
    Соединение.ИмяБазы = ПолучитьПеременнуюСреды("DB_NAME");
    Соединение.ИмяПользователя = ПолучитьПеременнуюСреды("DB_USER");
    Соединение.Пароль = ПолучитьПеременнуюСреды("DB_PASS");
    Соединение.Сервер = ПолучитьПеременнуюСреды("DB_HOST");
    Соединение.Порт = Число(ПолучитьПеременнуюСреды("DB_PORT"));
    Соединение.Открыть();
    Флаг = Истина;
    Пока Флаг = Истина Цикл
        Запрос = Новый Запрос();
        Запрос.УстановитьСоединение(Соединение);
        Запрос.Текст = "SELECT id FROM exchanges WHERE is_selected_gifters=false AND distribution_date <= @date";
        Запрос.УстановитьПараметр("date", НачалоДня(ТекущаяДата()));
        МассивИд = Новый Массив();
        Для Каждого Ид из Запрос.Выполнить().Выгрузить() Цикл
             МассивИд.Добавить(Ид.id);
        КонецЦикла;
        Для Каждого Ид Из МассивИд Цикл
            РаспределитьУчастников(Ид);
        КонецЦикла;
    Приостановить(43200);
    КонецЦикла;
КонецПроцедуры;
