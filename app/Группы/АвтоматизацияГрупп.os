&Пластилин Перем БрокерСообщенийСобытийСервера;
&пластилин Перем ФабрикаОтветов;

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

Функция НовоеСоединение() Экспорт
    Соединение = Новый Соединение();
    Соединение.ТипСУБД = Соединение.ТипыСУБД.PostgreSQL;
    Соединение.СтрокаСоединения = СтрШаблон(
        "Host=%1;Port=%2;Database=%3;Username=%4;Password=%5;Keepalive=30;Command Timeout=120",
        ПолучитьПеременнуюСреды("DB_HOST"), ПолучитьПеременнуюСреды("DB_PORT"),
        ПолучитьПеременнуюСреды("DB_NAME"), ПолучитьПеременнуюСреды("DB_USER"),
        ПолучитьПеременнуюСреды("DB_PASS"));
    Если Не Соединение.Открыть() Тогда
        ВызватьИсключение "Не удалось подключиться к БД: " + Соединение.ПоследнееСообщениеОбОшибке;
    КонецЕсли;
    Возврат Соединение;
КонецФункции

Функция РаспределитьУчастников(Ид, Соединение) Экспорт
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "SELECT u.id
    |FROM exchange_members m
    |JOIN exchanges e ON e.id = m.exchange_id
    |JOIN users u     ON u.id = m.user_id
    |WHERE m.exchange_id = @exchange_id
    |ORDER BY m.joined_at;";
    Запрос.УстановитьПараметр("exchange_id", Число(Ид));
    ПЗ = Запрос.Выполнить().Выгрузить();

    МассивПользователей = Новый Массив();
    Для Каждого П Из ПЗ Цикл
        МассивПользователей.Добавить(Строка(П.id));
    КонецЦикла;

    Генератор = Новый ГенераторСлучайныхЧисел;
    Последний = МассивПользователей.ВГраница();
    Для Сч = 0 По Последний - 1 Цикл
        Инд = Последний - Сч;                        // идём с конца
        Случайный = Генератор.СлучайноеЧисло(0, Инд);

        Временная = МассивПользователей[Инд];
        МассивПользователей[Инд] = МассивПользователей[Случайный];
        МассивПользователей[Случайный] = Временная;
    КонецЦикла;

    Распределение = Новый Соответствие();
    Для Сч = 0 По Последний Цикл
        Если Сч <> Последний Тогда
            Распределение.Вставить(МассивПользователей[Сч], МассивПользователей[Сч + 1]);
        Иначе
            Распределение.Вставить(МассивПользователей[Сч], МассивПользователей[0]);
        КонецЕсли;
    КонецЦикла;

    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "SELECT id, name, swap_date, money, place FROM exchanges WHERE id=@id";
    Запрос.УстановитьПараметр("id", Число(Ид));
    Для Каждого Г Из Запрос.Выполнить().Выгрузить() Цикл
        Группа = Новый Структура("exchange_id, name, swap_date, money, place", Г.id, Г.name, Г.swap_date, Г.money, Г.place);
        Для Каждого КЗ Из Распределение Цикл
            Группа.Вставить("giver_id", КЗ.Ключ);
            Запрос2 = Новый Запрос();
            Запрос2.УстановитьСоединение(Соединение);
            Запрос2.Текст = "SELECT id, first_name, last_name, username FROM users WHERE id=@id";
            Запрос2.УстановитьПараметр("id", Число(КЗ.Значение));
            Для Каждого П Из Запрос2.Выполнить().Выгрузить() Цикл
                ПС = Новый Структура("id, first_name, last_name, username", П.id, П.first_name, П.last_name, П.username);
                Группа.Вставить("receiver", ПС);
            КонецЦикла;
            Запись = Новый ЗаписьJSON();
            Запись.УстановитьСтроку();
            ЗаписатьJSON(Запись, Группа);
            З = Запись.Закрыть();
            Сообщение = ФабрикаОтветов.СерверноеСобытие();
            Сообщение.ТипСобытия("gift_assigned");
            Сообщение.ДобавитьСтроку(З);
           	БрокерСообщенийСобытийСервера.ОтправитьСообщениеВсем("/api/bot/events", Сообщение);
            Группа.Удалить("giver_id");
            Группа.Удалить("receiver");
        КонецЦикла;
    КонецЦикла;
    Запись = Новый ЗаписьJSON();
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Распределение);
    Распределение = Запись.Закрыть();

    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "UPDATE exchanges SET gifters=@gifters, is_selected_gifters=true WHERE id=@id";
    Запрос.УстановитьПараметр("id", Число(Ид));
    Запрос.УстановитьПараметр("gifters", Распределение);
    Запрос.ВыполнитьКоманду();
    Возврат Истина;
КонецФункции

Процедура АвтоматическоеЗавершение() Экспорт
    Флаг = Истина;
    Пока Флаг = Истина Цикл
        Соединение = НовоеСоединение();
        Запрос = Новый Запрос();
        Запрос.УстановитьСоединение(Соединение);
        Запрос.Текст = "UPDATE exchanges SET is_ended=true WHERE is_ended=false AND swap_date <= @date";
        Запрос.УстановитьПараметр("date", НачалоДня(ТекущаяДата()));
        Запрос.ВыполнитьКоманду();
        Соединение.Закрыть();
        Приостановить(43200);
    КонецЦикла;
КонецПроцедуры

Процедура АвтоматическоеРаспределение() Экспорт
    Флаг = Истина;
    Пока Флаг = Истина Цикл
        Соединение = НовоеСоединение();
        Запрос = Новый Запрос();
        Запрос.УстановитьСоединение(Соединение);
        Запрос.Текст = "SELECT id FROM exchanges WHERE is_selected_gifters=false AND distribution_date <= @date";
        Запрос.УстановитьПараметр("date", НачалоДня(ТекущаяДата()));
        МассивИд = Новый Массив();
        Для Каждого Ид из Запрос.Выполнить().Выгрузить() Цикл
             МассивИд.Добавить(Ид.id);
        КонецЦикла;
        Для Каждого Ид Из МассивИд Цикл
            РаспределитьУчастников(Ид, Соединение);
        КонецЦикла;
    Соединение.Закрыть();
    Приостановить(43200);
    КонецЦикла;
КонецПроцедуры;
