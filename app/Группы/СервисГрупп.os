Перем РГ;

Процедура ПриСозданииОбъекта() Экспорт
    РГ = Новый РепозиторийГрупп();
КонецПроцедуры

Функция СоздатьГруппу(id, ПП) Экспорт
    Группы = РГ.СоздатьГруппу(id, ПП);
    Для Каждого Гр Из Группы Цикл
        Информация = Новый Структура("place, money, distribution_date, swap_date", Гр.place, Гр.money, Гр.distribution_date, Гр.swap_date);
        СтруктГруппа = Новый Структура("id, name, admin_id, data, is_selected_gifters, is_ended, icon", Гр.id, Гр.name, Гр.admin_id, Информация, Гр.is_selected_gifters, Гр.is_ended, Гр.icon);
    КонецЦикла;
    Запись = Новый ЗаписьJSON();
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, СтруктГруппа);
    Возврат Запись.Закрыть();
КонецФункции

Функция ОбновитьГруппу(id, ПП) Экспорт
    Группы = РГ.ОбновитьГруппу(id, ПП);
    Для Каждого Гр Из Группы Цикл
        Информация = Новый Структура("place, money, distribution_date, swap_date", Гр.place, Гр.money, Гр.distribution_date, Гр.swap_date);
        СтруктГруппа = Новый Структура("id, name, admin_id, data, is_selected_gifters, is_ended, icon", Гр.id, Гр.name, Гр.admin_id, Информация, Гр.is_selected_gifters, Гр.is_ended, Гр.icon);
    КонецЦикла;
    Запись = Новый ЗаписьJSON();
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, СтруктГруппа);
    Возврат Запись.Закрыть();
КонецФункции

Функция УдалитьГруппу(ИдП, Ид) Экспорт
    Возврат РГ.УдалитьГруппу(ИдП, Ид);
КонецФункции

Функция ДобавитьПользователяВГруппу(ИдП,Ид) Экспорт
    Возврат РГ.ДобавитьПользователяВГруппу(ИдП,Ид);
КонецФункции

Функция ВыйтиИзГруппы(Ид, ИдГ) Экспорт
    Возврат РГ.УдалитьПользователя(Ид, Ид, ИдГ);
КонецФункции

Функция УдалитьИзГруппы(ИдП, ИдЦ, ИдГ) Экспорт
    Возврат РГ.УдалитьПользователя(ИдП, ИдЦ, ИдГ);
КонецФункции

Функция РаспределитьУчастников(ИдП, ИдГ) Экспорт
    Возврат РГ.Распределить(ИдП, ИдГ)
КонецФункции;
