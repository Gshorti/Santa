
Перем СтрокаИнициализации;
Перем Сервис;
Перем Парсер;
Перем КаталогФайлов;

&Контроллер("/api/groups")
Процедура ПриСозданииОбъекта()
        ПодключитьСценарий("app/Пользователи/initData.os", "initData");
    	СтрокаИнициализации = Новый initData();
        Сервис = Новый СервисГрупп();
        Парсер = Новый Парсеры();
        КаталогФайлов = ОбъединитьПути(ТекущийКаталог(), "uploads");
        СоздатьКаталог(КаталогФайлов);
КонецПроцедуры


&ТочкаМаршрута("create")
Процедура СоздатьГруппу(Ответ, Запрос) Экспорт
Заголовок = Запрос.Заголовки["Authorization"];
Заголовок = СтрРазделить(Заголовок, " ");
InitData = Заголовок[1];
	Пользователь = СтрокаИнициализации.ПроверитьInitData(InitData);
	Если Пользователь = "Invalid initData" Тогда
	    Ответ.УстановитьТипКонтента("txt");
		Ответ.УстановитьСостояниеНеАвторизован();
		Ответ.ТелоТекст = "Invalid initData";
	Иначе
	    ПП = Парсер.ПараметрыИзТекста(Запрос.Тело);
        Ответ.УстановитьТипКонтента("json");
        Ответ.ТелоТекст = Сервис.СоздатьГруппу(Пользователь["id"], ПП);
    КонецЕсли;
КонецПроцедуры

&ТочкаМаршрута("update")
Процедура ОбновитьГруппу(Ответ, Запрос) Экспорт
Заголовок = Запрос.Заголовки["Authorization"];
Заголовок = СтрРазделить(Заголовок, " ");
InitData = Заголовок[1];
	Пользователь = СтрокаИнициализации.ПроверитьInitData(InitData);
	Если Пользователь = "Invalid initData" Тогда
	    Ответ.УстановитьТипКонтента("txt");
		Ответ.УстановитьСостояниеНеАвторизован();
		Ответ.ТелоТекст = "Invalid initData";
	Иначе
	    ПП = Парсер.ПараметрыИзТекста(Запрос.Тело);
        Ответ.УстановитьТипКонтента("json");
        Ответ.ТелоТекст = Сервис.ОбновитьГруппу(Пользователь["id"], ПП);
    КонецЕсли;
КонецПроцедуры

&ТочкаМаршрута("delete")
Процедура УдалитьГруппу(Ответ, Запрос) Экспорт
Если Запрос.ПараметрыПорядковые.Количество() <> 1 Тогда
    Ответ.УстановитьСостояние(400);
    Ответ.УстановитьТипКонтента("txt");
    Ответ.ТелоТекст = "Некорректные порядковые параметры запроса";
Иначе
    Заголовок = Запрос.Заголовки["Authorization"];
    Заголовок = СтрРазделить(Заголовок, " ");
    InitData = Заголовок[1];
    	Пользователь = СтрокаИнициализации.ПроверитьInitData(InitData);
    	Если Пользователь = "Invalid initData" Тогда
    	    Ответ.УстановитьТипКонтента("txt");
    		Ответ.УстановитьСостояниеНеАвторизован();
    		Ответ.ТелоТекст = "Invalid initData";
    	Иначе
            Ответ.УстановитьТипКонтента("txt");
            Результат = Сервис.УдалитьГруппу(Пользователь["id"], Запрос.ПараметрыПорядковые[0]);
            Если Результат = Ложь Тогда
                Ответ.УстановитьСостояниеДоступЗакрыт();
                Ответ.ТелоТекст = "Недостаточно прав";
            Иначе
                Ответ.ТелоТекст = Результат;
            КонецЕсли;
        КонецЕсли;
КонецЕсли;
КонецПроцедуры

&ТочкаМаршрута("join")
Процедура ДобавитьПользователяВГруппу(Запрос, Ответ) Экспорт
    Если Запрос.ПараметрыПорядковые.Количество() <> 1 Тогда
        Ответ.УстановитьСостояние(400);
        Ответ.УстановитьТипКонтента("txt");
        Ответ.ТелоТекст = "Некорректные порядковые параметры запроса";
    Иначе
        Заголовок = Запрос.Заголовки["Authorization"];
        Заголовок = СтрРазделить(Заголовок, " ");
        InitData = Заголовок[1];
       	Пользователь = СтрокаИнициализации.ПроверитьInitData(InitData);
       	Если Пользователь = "Invalid initData" Тогда
       	    Ответ.УстановитьТипКонтента("txt");
      		Ответ.УстановитьСостояниеНеАвторизован();
      		Ответ.ТелоТекст = "Invalid initData";
       	Иначе
            Ответ.УстановитьТипКонтента("txt");
            Ответ.ТелоТекст = Сервис.ДобавитьПользователяВГруппу(Пользователь["id"], Запрос.ПараметрыПорядковые[0]);
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&ТочкаМаршрута("upload")
Процедура Загрузить(Запрос, Ответ) Экспорт
    ДанныеФайла = Запрос.ТелоДвоичныеДанные;
    Если ДанныеФайла = Неопределено ИЛИ ДанныеФайла.Размер() = 0 Тогда
        Ответ.УстановитьСостояние(400);
        Ответ.ТелоТекст = "Нет файла";
        Возврат;
    КонецЕсли;
    Ид = Строка(Новый УникальныйИдентификатор);
    Путь = ОбъединитьПути(КаталогФайлов, Ид);
    ДанныеФайла.Записать(Путь);
    Ответ.ТелоТекст = ПолучитьПеременнуюСреды("ADR") + "/files/" + Ид;
КонецПроцедуры

&ТочкаМаршрута("delete_user")
Процедура УдалитьПользователя(Ответ, ТелоЗапросаОбъект, ЗаголовкиЗапроса) Экспорт
Заголовок = ЗаголовкиЗапроса["Authorization"];
Заголовок = СтрРазделить(Заголовок, " ");
InitData = Заголовок[1];
	Пользователь = СтрокаИнициализации.ПроверитьInitData(InitData);
	Если Пользователь = "Invalid initData" Тогда
	    Ответ.УстановитьТипКонтента("txt");
		Ответ.УстановитьСостояниеНеАвторизован();
		Ответ.ТелоТекст = "Invalid initData";
	Иначе
	    Результат = Сервис.УдалитьИзГруппы(Пользователь["id"], ТелоЗапросаОбъект.user_id, ТелоЗапросаОбъект.group_id);
		Если Результат = Истина Тогда
            Ответ.УстановитьТипКонтента("txt");
            Ответ.ТелоТекст = "OK";
        Иначе
            Ответ.УстановитьТипКонтента("txt");
            Ответ.ТелоТекст = "ERR";
            Ответ.УстановитьСостояние(400);
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&ТочкаМаршрута("leave")
Процедура Выйти(Ответ, ТелоЗапросаОбъект, ЗаголовкиЗапроса) Экспорт
Заголовок = ЗаголовкиЗапроса["Authorization"];
Заголовок = СтрРазделить(Заголовок, " ");
InitData = Заголовок[1];
	Пользователь = СтрокаИнициализации.ПроверитьInitData(InitData);
	Если Пользователь = "Invalid initData" Тогда
	    Ответ.УстановитьТипКонтента("txt");
		Ответ.УстановитьСостояниеНеАвторизован();
		Ответ.ТелоТекст = "Invalid initData";
	Иначе
	    Результат = Сервис.ВыйтиИзГруппы(Пользователь["id"], ТелоЗапросаОбъект.group_id);
		Ответ.УстановитьТипКонтента("txt");
		Ответ.ТелоТекст = "OK";
    КонецЕсли;
КонецПроцедуры

&ТочкаМаршрута("distribution")
Процедура Распределить(Ответ, Запрос) Экспорт
Заголовок = Запрос.Заголовки["Authorization"];
Заголовок = СтрРазделить(Заголовок, " ");
InitData = Заголовок[1];
	Пользователь = СтрокаИнициализации.ПроверитьInitData(InitData);
	Если Пользователь = "Invalid initData" Тогда
	    Ответ.УстановитьТипКонтента("txt");
		Ответ.УстановитьСостояниеНеАвторизован();
		Ответ.ТелоТекст = "Invalid initData";
	Иначе
	    Результат = Сервис.РаспределитьУчастников(Пользователь["id"], Запрос.ПараметрыПорядковые[0]);
		Если Результат = Истина Тогда
            Ответ.УстановитьТипКонтента("txt");
            Ответ.ТелоТекст = "OK";
        Иначе
            Ответ.УстановитьТипКонтента("txt");
            Ответ.ТелоТекст = "ERR";
            Ответ.УстановитьСостояние(400);
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры
