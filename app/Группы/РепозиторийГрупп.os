&Пластилин Перем БрокерСообщенийСобытийСервера;
&Пластилин Перем ФабрикаОтветов;

Перем Соединение;
&Пластилин("АвтоматизацияГрупп") Перем Автоматизация;

&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры

Функция НовоеСоединение() Экспорт
    Соединение = Новый Соединение();
    Соединение.ТипСУБД = Соединение.ТипыСУБД.PostgreSQL;
    Соединение.СтрокаСоединения = СтрШаблон(
        "Host=%1;Port=%2;Database=%3;Username=%4;Password=%5;Keepalive=30;Command Timeout=120",
        ПолучитьПеременнуюСреды("DB_HOST"), ПолучитьПеременнуюСреды("DB_PORT"),
        ПолучитьПеременнуюСреды("DB_NAME"), ПолучитьПеременнуюСреды("DB_USER"),
        ПолучитьПеременнуюСреды("DB_PASS"));
    Если Не Соединение.Открыть() Тогда
        ВызватьИсключение "Не удалось подключиться к БД: " + Соединение.ПоследнееСообщениеОбОшибке;
    КонецЕсли;
    Возврат Соединение;
КонецФункции

Функция СоздатьГруппу(id, ПП) Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "WITH new_exchange AS (
    |    INSERT INTO exchanges (
    |        name, admin_id, place, money,
    |        distribution_date, swap_date, icon
    |    )
    |    VALUES (
    |        @name, @admin_id, @place, @money,
    |        @distribution_date, @swap_date, @icon
    |    )
    |    RETURNING id
    |)
    |INSERT INTO exchange_members (exchange_id, user_id)
    |SELECT id, @admin_id FROM new_exchange
    |RETURNING exchange_id;";
    Запрос.УстановитьПараметр("name", ПП["name"]);
    Запрос.УстановитьПараметр("admin_id", id);
    Запрос.УстановитьПараметр("place", ПП["place"]);
    Запрос.УстановитьПараметр("money", Число(ПП["money"]));
    Запрос.УстановитьПараметр("distribution_date", НачалоДня(Дата(СтрСоединить(СтрРазделить(СтрРазделить(ПП["distribution_date"], "T")[0],"-" ), ""))));
    Запрос.УстановитьПараметр("swap_date", НачалоДня(Дата(СтрСоединить(СтрРазделить(СтрРазделить(ПП["swap_date"], "T")[0],"-" ), ""))));
    Запрос.УстановитьПараметр("icon", ПП["icon"]);
    Запрос.УстановитьПараметр("gifters", "{}");
    Результат = Запрос.Выполнить().Выгрузить();
    Для Каждого Рез Из Результат Цикл
        Ид = Рез.exchange_id;
    КонецЦикла;

    Запрос2 = Новый Запрос();
    Запрос2.УстановитьСоединение(Соединение);
    Запрос2.Текст = "SELECT * FROM exchanges WHERE id=@id";
    Запрос2.УстановитьПараметр("id", Ид);
    Рез = Запрос2.Выполнить().Выгрузить();
    Соединение.Закрыть();
    Возврат Рез;
КонецФункции

Функция ОбновитьГруппу(id, ПП) Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "UPDATE exchanges SET
    |name=@name,
    |admin_id=@admin_id,
    |place=@place,
    |money=@money,
    |distribution_date=@distribution_date,
    |swap_date=@swap_date,
    |icon=@icon  WHERE id=@id";
    Запрос.УстановитьПараметр("name", ПП["name"]);
    Запрос.УстановитьПараметр("admin_id", ПП["admin_id"]);
    Запрос.УстановитьПараметр("place", ПП["place"]);
    Запрос.УстановитьПараметр("money", Число(ПП["money"]));
    Запрос.УстановитьПараметр("distribution_date", НачалоДня(Дата(СтрСоединить(СтрРазделить(СтрРазделить(ПП["distribution_date"], "T")[0],"-" ), ""))));
    Запрос.УстановитьПараметр("swap_date", НачалоДня(Дата(СтрСоединить(СтрРазделить(СтрРазделить(ПП["swap_date"], "T")[0],"-" ), ""))));
    Запрос.УстановитьПараметр("icon", ПП["icon"]);
    Запрос.УстановитьПараметр("id", Число(ПП["group_id"]));
    Результат = Запрос.Выполнить().Выгрузить();
    Для Каждого Рез Из Результат Цикл
        Ид = Рез.exchange_id;
    КонецЦикла;

    Запрос2 = Новый Запрос();
    Запрос2.УстановитьСоединение(Соединение);
    Запрос2.Текст = "SELECT * FROM exchanges WHERE id=@id";
    Запрос2.УстановитьПараметр("id", Число(ПП["group_id"]));
    Рез = Запрос2.Выполнить().Выгрузить();
    Соединение.Закрыть();
    Возврат Рез;
КонецФункции

Функция УдалитьГруппу(ИдП, Ид) Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "SELECT admin_id FROM exchanges WHERE id=@id";
    Запрос.УстановитьПараметр("id", Число(Ид));
    ГР = Запрос.Выполнить().Выгрузить();
    Для Каждого Г Из ГР Цикл
        Админ = Г.admin_id;
    КонецЦикла;
    Если Админ <> ИдП Тогда
        Возврат Ложь;
    Иначе
        Запрос2 = Новый Запрос();
        Запрос2.УстановитьСоединение(Соединение);
        Запрос2.Текст = "DELETE FROM exchanges WHERE id=@id";
        Запрос2.УстановитьПараметр("id", Число(Ид));
        Запрос2.ВыполнитьКоманду();
        Соединение.Закрыть();
        Возврат "OK";
    КонецЕсли;
КонецФункции

Функция ДобавитьПользователяВГруппу(ИдП, Ид) Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "INSERT INTO exchange_members (exchange_id, user_id)
    |SELECT id, @user_id
    |FROM exchanges
    |WHERE id = @exchange_id
    |  AND NOT is_ended
    |  AND NOT is_selected_gifters
    |ON CONFLICT (exchange_id, user_id) DO NOTHING
    |RETURNING exchange_id;";
    Запрос.УстановитьПараметр("exchange_id", Число(Ид));
    Запрос.УстановитьПараметр("user_id", Число(ИдП));
    Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
        Если Число(Стр.exchange_id) <> Число(Ид) Тогда
            Соединение.Закрыть();
            Возврат "ERR";
        КонецЕсли;
    КонецЦикла;
    Запрос2 = Новый Запрос();
    Запрос2.УстановитьСоединение(Соединение);
    Запрос2.Текст = "SELECT id, name, admin_id FROM exchanges WHERE id=@id";
    Запрос2.УстановитьПараметр("id", Число(Ид));
    Для Каждого Стр Из Запрос2.Выполнить().Выгрузить() Цикл
        Группа = Новый Структура("exchange_id, name, admin_id", Стр.id, Стр.name, Стр.admin_id);
    КонецЦикла;
    Запрос3 = Новый Запрос();
    Запрос3.УстановитьСоединение(Соединение);
    Запрос3.Текст = "SELECT id, first_name, last_name, username FROM users WHERE id=@id";
    Запрос3.УстановитьПараметр("id", Число(ИдП));
    Для Каждого С Из Запрос3.Выполнить().Выгрузить() Цикл
        П = Новый Структура("id, first_name, last_name, username", С.id, С.first_name, С.last_name, С.username);
    КонецЦикла;
    Группа.Вставить("user", П);
    Запись = Новый ЗаписьJSON();
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Группа);
    Г = Запись.Закрыть();
    Сообщение = ФабрикаОтветов.СерверноеСобытие();
	Сообщение.ТипСобытия("member_joined");
	Сообщение.ДобавитьСтроку(Г);
	БрокерСообщенийСобытийСервера.ОтправитьСообщениеВсем("/api/bot/events", Сообщение);
	Соединение.Закрыть();
    Возврат "OK";
КонецФункции

Функция УдалитьПользователя(ИдП, ИдЦ, ИдГ) Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "SELECT admin_id FROM exchanges WHERE id=@id";
    Запрос.УстановитьПараметр("id", Число(ИдГ));
    ГР = Запрос.Выполнить().Выгрузить();
    Для Каждого Г Из ГР Цикл
        Админ = Г.admin_id;
    КонецЦикла;
    Если Число(Админ) <> Число(ИдП) Тогда
        Рез = Ложь;
    Иначе
        Рез = Истина;
    КонецЕсли;
    Запрос2 = Новый Запрос();
    Запрос2.УстановитьСоединение(Соединение);
    Запрос2.Текст = "DELETE FROM exchange_members m
    |USING exchanges e
    |WHERE m.exchange_id = e.id
    |  AND e.id = @exchange_id
    |  AND m.user_id = @target_user_id
    |  AND NOT e.is_selected_gifters
    |  AND m.user_id <> e.admin_id
    |  AND (m.user_id = @user_id OR e.admin_id = @user_id)
    |RETURNING (m.user_id = e.admin_id) AS res;";
    Запрос2.УстановитьПараметр("exchange_id", Число(ИдГ));
    Запрос2.УстановитьПараметр("target_user_id", Число(ИдЦ));
    Запрос2.УстановитьПараметр("user_id", Число(ИдП));
    Запрос2.ВыполнитьКоманду();
    Соединение.Закрыть();
    Возврат Рез;
КонецФункции

Функция Распределить(ИдП, Ид) Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "SELECT admin_id FROM exchanges WHERE id=@id";
    Запрос.УстановитьПараметр("id", Число(Ид));
    ГР = Запрос.Выполнить().Выгрузить();
    Для Каждого Г Из ГР Цикл
        Админ = Г.admin_id;
    КонецЦикла;
    Если Число(Админ) <> Число(ИдП) Тогда
        Соединение.Закрыть();
        Возврат Ложь;
    Иначе
        Рез = Автоматизация.РаспределитьУчастников(Ид, Соединение);
        Если Рез <> Ложь Тогда
            Соединение.Закрыть();
            Возврат Истина;
        Иначе
            Соединение.Закрыть();
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;
КонецФункции

Функция ПолучитьНезавершённые() Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "SELECT id, name, swap_date, place, money FROM exchanges WHERE is_ended=false";
    МассивГрупп = Новый Массив();
    Для Каждого Г Из Запрос.Выполнить().Выгрузить() Цикл
        Группа = Новый Структура("id, name, swap_date, money, place", Г.id, Г.name, Г.swap_date, Г.money, Г.place);
        МассивПользователей = Новый Массив();
        Запрос2 = Новый Запрос();
        Запрос2.УстановитьСоединение(Соединение);
        Запрос2.Текст = "SELECT u.id
        |FROM exchange_members m
        |JOIN exchanges e ON e.id = m.exchange_id
        |JOIN users u     ON u.id = m.user_id
        |WHERE m.exchange_id = @exchange_id
        |ORDER BY m.joined_at;";
        Запрос2.УстановитьПараметр("exchange_id", Число(Г.id));
        Для Каждого П Из Запрос2.Выполнить().Выгрузить() Цикл
            МассивПользователей.Добавить(Число(П.id));
        КонецЦикла;
        Группа.Вставить("member_ids", МассивПользователей);
        МассивГрупп.Добавить(Группа);
    КонецЦикла;
    Соединение.Закрыть();
    Возврат МассивГрупп;
КонецФункции
