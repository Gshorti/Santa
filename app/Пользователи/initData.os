&Желудь
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

Функция ПроверитьInitData(Знач InitData) Экспорт

	МаксВозрастСек = 86400;

	// 1-2. Разбор на пары, hash отделяем
	Пары = Новый ТаблицаЗначений;
	Пары.Колонки.Добавить("Ключ");
	Пары.Колонки.Добавить("Значение");

	ПолученныйХэш = "";
	ЗначениеUser = "";
	AuthDate = "0";

	Для Каждого Часть Из СтрРазделить(InitData, "&") Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Лев(Часть, Позиция - 1);
		Значение = РаскодироватьИзURL(Сред(Часть, Позиция + 1));

		Если Ключ = "hash" Тогда
			ПолученныйХэш = Значение;
			Продолжить;
		КонецЕсли;
		Если Ключ = "user" Тогда
			ЗначениеUser = Значение;
		ИначеЕсли Ключ = "auth_date" Тогда
			AuthDate = Значение;
		КонецЕсли;

		НоваяСтрока = Пары.Добавить();
		НоваяСтрока.Ключ = Ключ;
		НоваяСтрока.Значение = Значение;
	КонецЦикла;

	// 3. Сортировка по ключу и склейка через \n
	Пары.Сортировать("Ключ");
	Строки = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Строки.Добавить(Пара.Ключ + "=" + Пара.Значение);
	КонецЦикла;
	DataCheckString = СтрСоединить(Строки, Символы.ПС);

	// 4. secret_key = HMAC_SHA256(key = "WebAppData", message = BOT_TOKEN)
	СекретныйКлюч = Шифрование.HMAC(
		ПолучитьДвоичныеДанныеИзСтроки("WebAppData", КодировкаТекста.UTF8),
		ПолучитьДвоичныеДанныеИзСтроки(ПолучитьПеременнуюСреды("BOT_TOKEN"), КодировкаТекста.UTF8),
		ХешФункция.SHA256);

	// 5. calc_hash = hex(HMAC_SHA256(key = secret_key, message = data_check_string))
	// НРег: .NET отдаёт hex в верхнем регистре, а Telegram присылает в нижнем.
	CalcHash = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Шифрование.HMAC(
		СекретныйКлюч,
		ПолучитьДвоичныеДанныеИзСтроки(DataCheckString, КодировкаТекста.UTF8),
		ХешФункция.SHA256)));

	// 6. Сравнение
	СовпалХэш = РавныБезРаннегоВыхода(CalcHash, НРег(ПолученныйХэш));

	// 7. Свежесть auth_date
	ВозрастСек = (ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1)) - Число(AuthDate);
	Свежий = (ВозрастСек >= 0 И ВозрастСек <= МаксВозрастСек);

	Если СовпалХэш И Свежий Тогда
	    Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ЗначениеUser);
		Пользователь = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат Пользователь;
	Иначе
	    Возврат "Invalid initData";
	КонецЕсли;
КонецФункции

// Без раннего выхода, чтобы время не зависело от места первого расхождения.
Функция РавныБезРаннегоВыхода(Знач А, Знач Б) Экспорт
	Если СтрДлина(А) <> СтрДлина(Б) Тогда
		Возврат Ложь;
	КонецЕсли;
	Расхождений = 0;
	Для Индекс = 1 По СтрДлина(А) Цикл
		Если КодСимвола(А, Индекс) <> КодСимвола(Б, Индекс) Тогда
			Расхождений = Расхождений + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождений = 0;
КонецФункции

Функция РаскодироватьИзURL(Знач Строка_) Экспорт
	Строка_ = СтрЗаменить(Строка_, "+", " ");
	Возврат РаскодироватьСтроку(Строка_, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция ВJSON(Данные) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции
