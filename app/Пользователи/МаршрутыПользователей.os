Перем СтрокаИнициализации;
Перем Сервис;

&Контроллер("/api/users")
Процедура ПриСозданииОбъекта()
	СтрокаИнициализации = Новый initData();
	Сервис = Новый СервисПользователей();

КонецПроцедуры

&ТочкаМаршрута("me")
Процедура ПолучитьПользователя(Ответ, Запрос) Экспорт
    Заголовок = Запрос.Заголовки["Authorization"];
    Заголовок = СтрРазделить(Заголовок, " ");
    InitData = Заголовок[1];
	Пользователь = СтрокаИнициализации.ПроверитьInitData(InitData);
	Если Пользователь = "Invalid initData" Тогда
	    Ответ.УстановитьТипКонтента("txt");
		Ответ.УстановитьСостояниеНеАвторизован();
		Ответ.ТелоТекст = "Invalid initData";
	Иначе
        Ответ.УстановитьТипКонтента("json"); //json
        Ответ.УстановитьСостояниеОК();
        Ответ.ТелоТекст = Сервис.ПолучитьПользователя(Пользователь);
    КонецЕсли;
КонецПроцедуры
