Перем Соединение;

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

Функция НовоеСоединение() Экспорт
    Соединение = Новый Соединение();
    Соединение.ТипСУБД = Соединение.ТипыСУБД.PostgreSQL;
    Соединение.СтрокаСоединения = СтрШаблон(
        "Host=%1;Port=%2;Database=%3;Username=%4;Password=%5;Keepalive=30;Command Timeout=120",
        ПолучитьПеременнуюСреды("DB_HOST"), ПолучитьПеременнуюСреды("DB_PORT"),
        ПолучитьПеременнуюСреды("DB_NAME"), ПолучитьПеременнуюСреды("DB_USER"),
        ПолучитьПеременнуюСреды("DB_PASS"));
    Если Не Соединение.Открыть() Тогда
        ВызватьИсключение "Не удалось подключиться к БД: " + Соединение.ПоследнееСообщениеОбОшибке;
    КонецЕсли;
    Возврат Соединение;
КонецФункции

Функция СоздатьИлиОбновить(Пользователь) Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "INSERT INTO users (id, first_name, last_name, username, photo_url)
        |VALUES (@id, @first_name, @last_name, @username, @photo_url)
        |ON CONFLICT (id) DO UPDATE SET
        |first_name = EXCLUDED.first_name,
        |last_name  = EXCLUDED.last_name,
        |username   = EXCLUDED.username,
        |photo_url  = EXCLUDED.photo_url";
    Запрос.УстановитьПараметр("id", Пользователь["id"]);
    Запрос.УстановитьПараметр("first_name", Пользователь["first_name"]);
    Запрос.УстановитьПараметр("last_name", Пользователь["last_name"]);
    Запрос.УстановитьПараметр("username", Пользователь["username"]);
    Запрос.УстановитьПараметр("photo_url", Пользователь["photo_url"]);
    Запрос.ВыполнитьКоманду();

    Соединение2 = Новый Соединение();
    Соединение2.ТипСУБД = Соединение.ТипыСУБД.PostgreSQL;
    Соединение2.ИмяБазы = ПолучитьПеременнуюСреды("DB_NAME");
    Соединение2.ИмяПользователя = ПолучитьПеременнуюСреды("DB_USER");
    Соединение2.Пароль = ПолучитьПеременнуюСреды("DB_PASS");
    Соединение2.Сервер = ПолучитьПеременнуюСреды("DB_HOST");
    Соединение2.Порт = Число(ПолучитьПеременнуюСреды("DB_PORT"));
    Соединение2.Открыть();
    Запрос2 = Новый Запрос();
    Запрос2.УстановитьСоединение(Соединение2);
    Запрос2.Текст = "select * from users where id = @id";
    Запрос2.УстановитьПараметр("id", Пользователь["id"]);
    Результат = Запрос2.Выполнить().Выгрузить();
    Соединение.Закрыть();
    Возврат Результат;
КонецФункции

Функция ПолучитьВсеГруппыПользователя(Ид) Экспорт
    Соединение = НовоеСоединение();
    Запрос = Новый Запрос();
    Запрос.УстановитьСоединение(Соединение);
    Запрос.Текст = "SELECT e.id,
    |       e.name,
    |       e.admin_id,
    |       e.place,
    |       e.money,
    |       e.distribution_date,
    |       e.swap_date,
    |       e.is_selected_gifters,
    |       e.is_ended,
    |       e.icon,
    |       e.gifters,
    |       (e.admin_id = @user_id) AS is_admin,
    |       (SELECT count(*) FROM exchange_members
    |        WHERE exchange_id = e.id) AS members_count
    |FROM exchange_members m
    |JOIN exchanges e ON e.id = m.exchange_id
    |WHERE m.user_id = @user_id
    |ORDER BY e.is_ended, e.swap_date NULLS LAST, e.id;";
    Запрос.УстановитьПараметр("user_id", Число(Ид));
    Группы = Новый Массив();
    Для Каждого ГР Из Запрос.Выполнить().Выгрузить() Цикл
        Запрос2 = Новый Запрос();
        Запрос2.УстановитьСоединение(Соединение);
        Запрос2.Текст = "SELECT u.id
        |FROM exchange_members m
        |JOIN exchanges e ON e.id = m.exchange_id
        |JOIN users u     ON u.id = m.user_id
        |WHERE m.exchange_id = @exchange_id
        |ORDER BY m.joined_at;";
        Запрос2.УстановитьПараметр("exchange_id", Число(ГР.id));
        ПЗ = Запрос2.Выполнить().Выгрузить();
        Пользователи = Новый Массив();
        Для Каждого П Из ПЗ Цикл
            Пользователи.Добавить(Строка(П.id));
        КонецЦикла;
        Группы.Добавить(Новый Структура("id, name, admin_id, place, money,
        |distribution_date, swap_date, is_selected_gifters, is_ended, icon, gifters,
        |users", ГР.id, ГР.name, ГР.admin_id, ГР.place, ГР.money, ГР.distribution_date, ГР.swap_date, ГР.is_selected_gifters, ГР.is_ended, ГР.icon, ГР.gifters, Пользователи));
    КонецЦикла;
    Для Каждого Группа Из Группы Цикл
        Запрос3 = Новый Запрос();
        Запрос3.УстановитьСоединение(Соединение);
        Запрос3.Текст = "SELECT id, first_name, last_name, username, photo_url FROM users WHERE id IN (" + СтрСоединить(Группа["users"], ",") + ")";
        Пользователи = Новый Массив();
        Для Каждого Пользователь Из Запрос3.Выполнить().Выгрузить() Цикл
            Пользователи.Добавить(Новый Структура("id, first_name, last_name, username, photo_url", Пользователь.id, Пользователь.first_name, Пользователь.last_name, Пользователь.username, Пользователь.photo_url));
        КонецЦикла;
        Группа.Вставить("users", Пользователи);
    КонецЦикла;
    Соединение.Закрыть();
    Возврат Группы;
КонецФункции
