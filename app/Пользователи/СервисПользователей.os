&Пластилин("РепозиторийПользователей") Перем Репозиторий;

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры


Функция ПолучитьПользователя(Пользователь) Экспорт
    ДанныеПользователя = Репозиторий.СоздатьИлиОбновить(Пользователь);
    Для Каждого Пользователь Из ДанныеПользователя Цикл
        ПользовательСтруктура = Новый Структура("id, first_name, last_name, username, photo_url", Пользователь.id, Пользователь.first_name, Пользователь.last_name, Пользователь.username, Пользователь.photo_url);
    КонецЦикла;
    Группы = Репозиторий.ПолучитьВсеГруппыПользователя(Пользователь["id"]);
    Для Каждого Группа Из Группы Цикл
        Если Группа["is_selected_gifters"] = Истина Тогда
            Чтение = Новый ЧтениеJSON();
            Чтение.УстановитьСтроку(Группа["gifters"]);
            Распределение = ПрочитатьJSON(Чтение, Истина);
            Чтение.Закрыть();
            Получатель = Распределение[Строка(Пользователь["id"])];
            Для Каждого П Из Группа["users"] Цикл
                Если Строка(П["id"]) = Строка(Получатель) Тогда
                    Группа.Вставить("recipient", П);
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Группа.Удалить("gifters");
    КонецЦикла;
    ПользовательСтруктура.Вставить("groups", Группы);
    Запись = Новый ЗаписьJSON();
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, ПользовательСтруктура);
    Возврат Запись.Закрыть();
КонецФункции
